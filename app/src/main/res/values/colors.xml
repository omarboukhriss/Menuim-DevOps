<?xml version="1.0" encoding="utf-8"?>
<!-- colors.xml — color palette used throughout the app -->
<resources>

    <!-- ── Primary brand colors (dark green = restaurant/nature feel) ── -->
    <color name="primary">#1B5E20</color>
    <color name="primary_variant">#388E3C</color>
    <color name="on_primary">#FFFFFF</color>

    <!-- ── Secondary accent (warm orange) ── -->
    <color name="secondary">#FF6F00</color>
    <color name="secondary_variant">#FFA000</color>
    <color name="on_secondary">#000000</color>

    <!-- ── Backgrounds and surfaces ── -->
    <color name="background">#FAFAFA</color>
    <color name="surface">#FFFFFF</color>
    <color name="on_background">#212121</color>
    <color name="on_surface">#212121</color>

    <!-- ── Error ── -->
    <color name="error">#B00020</color>
    <color name="on_error">#FFFFFF</color>

    <!-- ── Status colors (used on order cards) ── -->
    <color name="status_pending">#FFA000</color>
    <color name="status_accepted">#1976D2</color>
    <color name="status_rejected">#D32F2F</color>
    <color name="status_preparing">#FF6F00</color>
    <color name="status_ready">#388E3C</color>
    <color name="status_served">#1B5E20</color>

    <!-- ── Stock warning ── -->
    <color name="low_stock_red">#D32F2F</color>
</resources>
